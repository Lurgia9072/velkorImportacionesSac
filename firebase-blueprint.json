{
  "entities": {
    "products": {
      "title": "Product",
      "description": "Repuestos y accesorios de motos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "showPrice": { "type": "boolean" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Nuevo", "Promoción", "Importación próxima", "Catálogo general"] },
        "description": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "views": { "type": "number" },
        "sales": { "type": "number" },
        "code": { "type": "string" }
      },
      "required": ["name", "category", "status", "description"]
    },
    "orders": {
      "title": "Order",
      "description": "Pedidos de clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productPrice": { "type": "number" },
        "productCode": { "type": "string" },
        "quantity": { "type": "number" },
        "requestType": { "type": "string", "enum": ["Compra directa", "Consulta", "Cotización"] },
        "paymentMethod": { "type": "string", "enum": ["50/50", "20% adelanto / 80% entrega", "Otro"] },
        "status": { "type": "string", "enum": ["En seguimiento", "Cotizado", "Venta cerrada", "No compró"] },
        "noPurchaseReason": { "type": "string" },
        "quotationId": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "orderGroupId": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "deliveryAddress", "productId", "productName", "quantity", "requestType", "paymentMethod", "status"]
    },
    "quotations": {
      "title": "Quotation",
      "description": "Cotizaciones formales para clientes y mayoristas con cálculo de IGV y PDF",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quoteNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerDocType": { "type": "string", "enum": ["RUC", "DNI", "CE"] },
        "customerDocNumber": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendiente", "Pagado", "Empacando Pedido", "Despachado", "Entregado", "No Concretada", "Cancelada", "Pagada", "Empacar pedido", "Enviada (Falta pagar)"] },
        "noPurchaseReason": { "type": "string" },
        "subtotal": { "type": "number" },
        "igvAmount": { "type": "number" },
        "total": { "type": "number" },
        "includeIgv": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quoteNumber", "customerName", "customerDocNumber", "status", "total"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "products",
      "description": "Colección de productos del catálogo de Velkor Importaciones"
    },
    "orders/{orderId}": {
      "schema": "orders",
      "description": "Colección de pedidos y cotizaciones de clientes"
    },
    "quotations/{quotationId}": {
      "schema": "quotations",
      "description": "Colección de cotizaciones formales para clientes y mayoristas"
    }
  }
}
